#ArraySum
import java.util.Arrays;

public class Main
{
	public static void main(String[] args) {
		int sum = 0;
		int array[] = {1 , 2, 5 , 7, 8, 12};
		
	    for(int i=0;i<array.length;i++){
	        sum = sum + array[i];
	    }
	    
	    System.out.println("The sum is " + sum);
	}
}

